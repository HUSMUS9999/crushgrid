# crushgrid N-node cluster configuration
# Copy to cluster.conf and restrict permissions: chmod 600 cluster.conf
# Usage:
#   crushgrid probe --cluster cluster.conf
#   crushgrid pack ./data -o ./data.sqz --cluster cluster.conf --pick

# Generate with: openssl rand -hex 32
token = REPLACE_WITH_YOUR_64_CHAR_HEX_TOKEN

# aead      = mutual BLAKE3 auth + per-session AES-256-GCM (default; required over public Internet)
# auth-only = mutual BLAKE3 auth + XXH3 integrity (optional inside WireGuard/Tailscale tunnels)
security = aead

# auto  = zstd1 on links <100 MiB/s (Wi-Fi/WAN), lz4 on links >=100 MiB/s (GbE/VPC)
# zstd1 = force zstd level 1 wire pre-shrink
# lz4   = force lz4 wire pre-shrink
# none  = disable wire pre-shrink
wire_codec = auto

# Coordinator hard RAM limit (defaults to 1/3 available RAM, clamped to 256 MiB..4 GiB)
mem_limit = 4G

# Default parallel TCP streams per remote node (clamped to 1..=8)
streams = 2

# Local coordinator (threads=auto reserves 1-2 threads for I/O when remote nodes are active)
node = local:threads=auto,mem=4G

# LAN nodes
node = 192.168.1.40:7878:threads=max,mem=8G,streams=2
node = 192.168.1.41:7878:threads=75%,mem=4G,streams=2

# Tailscale / WireGuard peers
# node = 100.64.0.10:7878:threads=max,mem=16G,streams=3

# Public Internet / cloud workers
# Note: bw= is in bytes/sec (10M = 10 MiB/s ~= 84 Mbps)
# node = worker1.example.com:7878:threads=64,mem=32G,streams=6,bw=10M
